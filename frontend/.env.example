# Public API URL used in the browser
NEXT_PUBLIC_BACKEND_URI=http://localhost:8000

# Server-side API URL (SSR / proxy)
BACKEND_SERVER_URI=http://localhost:8000

# Comma-separated hostnames allowed for next/image
NEXT_PUBLIC_IMAGE_HOSTS=s3.example.com

# Ads placeholder: ON | OFF
NEXT_PUBLIC_ADS_STATE=OFF

# Yandex Metrika: ON | OFF
NEXT_PUBLIC_YAMETRIKA_STATE=OFF
NEXT_PUBLIC_YAMETRIKA_ID=
